				    #"Replaced Value1" = Table.ReplaceValue(#"Replaced Value","widraw","WITHDRAW",Replacer.ReplaceText,{"Status"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","failed","cancelled",Replacer.ReplaceText,{"Status"}),
				    #"Replaced Value3" = Table.ReplaceValue(#"Replaced Value2","evaluating","Appraisal Verified ",Replacer.ReplaceText,{"Status"}),
				    #"Added Custom" = Table.AddColumn(#"Replaced Value3", "Unified_ID", each if [ID] <= 616 then "EX-" & Text.From([ID])
				else if [ID] <= 1000 then "KB-" & Text.From([ID])
				else "PMS-" & Text.From([ID])),
