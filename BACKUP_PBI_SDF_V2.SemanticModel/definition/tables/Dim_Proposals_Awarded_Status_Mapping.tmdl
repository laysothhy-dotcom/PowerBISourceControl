table Dim_Proposals_Awarded_Status_Mapping
	lineageTag: 1ee06edd-e61e-4e52-8403-dacc400baba2

	measure Total_Approved = ```
			CALCULATE(
			    COUNT('Dim_Proposals_Awarded_Status_Mapping'[Status]),
			    'Dim_Proposals_Awarded_Status_Mapping'[Status] = "MANUALLY_APPROVED"
			) 
			```
		formatString: 0
		lineageTag: c1a17fef-6a52-45d6-8112-6fd8e2f69d2f

	measure Grand_Total_Approved =
			
			[Total_Approved_pms] + [Total_Approved]
		formatString: 0
		lineageTag: a093853b-c221-4b94-958f-545735726350

	column ID
		dataType: int64
		formatString: 0
		lineageTag: dc02b0fc-7b6c-4789-8cc2-e8f70366b042
