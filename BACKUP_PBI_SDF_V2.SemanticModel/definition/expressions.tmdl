expression fnReplaceUnicode =
		(TextValue as text, MappingTable as table, TargetColumn as text, ReplacementColumn as text) as text =>
		let
		    // Convert the mapping table to a list of records for easy iteration
		    MappingList = Table.ToRecords(MappingTable),
		
		    // Function to apply a single replacement
		    ApplyReplacement = (CurrentText as text, MappingRecord as record) as text =>
		        Text.Replace(
		            CurrentText,
		            Record.Field(MappingRecord, TargetColumn),
		            Record.Field(MappingRecord, ReplacementColumn)
		        ),
		
		    // Iterate through the list of mappings and apply all replacements
		    Result = List.Accumulate(
		        MappingList,
		        TextValue,
		        (CurrentText, MappingRecord) => ApplyReplacement(CurrentText, MappingRecord)
		    )
		in
		    Result
	lineageTag: 90d50116-6481-4556-9cc7-06d4700328aa
